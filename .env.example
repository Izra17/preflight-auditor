# --- Optional AI layer -------------------------------------------------
# If unset, the app runs fully deterministic audits and shows
# "AI analysis unavailable" instead of crashing.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Audit engine tuning -------------------------------------------------
# Hard ceiling on total audit wall-clock time (ms).
AUDIT_TIMEOUT_MS=45000
# Navigation timeout (ms).
AUDIT_NAV_TIMEOUT_MS=20000
# Max concurrent audits the single Node process will run at once.
AUDIT_MAX_CONCURRENCY=2

# --- Persistence ---------------------------------------------------------
# "memory" (default, resets on restart) or "file" (JSON file under .data/)
PREFLIGHT_STORE=file
